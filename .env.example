# Resend API key (https://resend.com → API Keys). Replace before deploy.
RESEND_API_KEY=re_PLACEHOLDER_REPLACE_BEFORE_DEPLOY

# Public site URL — no trailing slash
PUBLIC_SITE_URL=https://finanzkompass.de

# Newsletter sender (must be a verified Resend domain)
NEWSLETTER_FROM_EMAIL=newsletter@finanzkompass.de
NEWSLETTER_FROM_NAME=Finanzkompass

# Cashback antrag recipient
CASHBACK_RECIPIENT_EMAIL=cashback@finanzkompass.de
