---
import AffiliateLink from './AffiliateLink.astro';
import CashbackPill from './CashbackPill.astro';

export interface Props {
  produktName: string;
  produktAnbieter: string;
  bewertung: number;
  bestFuer: string;
  preisInfo: string;
  affiliateUrl: string;
  cashbackVerfuegbar?: boolean;
  cashbackBetrag?: number;
  saeule: 'finance' | 'wellbeing';
  empfohlenBadge?: boolean;
}

const {
  produktName, produktAnbieter, bewertung, bestFuer, preisInfo,
  affiliateUrl, cashbackVerfuegbar = false, cashbackBetrag,
  saeule, empfohlenBadge = false,
} = Astro.props;

const sterne = Math.round((bewertung / 10) * 5 * 2) / 2;
const fullStars = Math.floor(sterne);
const halfStar = sterne - fullStars >= 0.5;
const emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
---
<aside class="verdict-box" data-saeule={saeule}>
  {empfohlenBadge && <span class="verdict-badge">Empfehlung der Redaktion</span>}
  <div class="verdict-anbieter">{produktAnbieter}</div>
  <h2 class="verdict-produkt">{produktName}</h2>

  <div class="verdict-rating">
    <div class="verdict-stars" aria-label={`Bewertung ${bewertung} von 10`}>
      {Array.from({ length: fullStars }).map(() => <span class="star">★</span>)}
      {halfStar && <span class="star">⯨</span>}
      {Array.from({ length: emptyStars }).map(() => <span class="star empty">☆</span>)}
    </div>
    <div class="verdict-score"><strong>{bewertung.toFixed(1)}</strong> <span>/ 10</span></div>
  </div>

  <dl class="verdict-meta">
    <dt>Empfohlen für</dt>
    <dd>{bestFuer}</dd>
    <dt>Preis</dt>
    <dd>{preisInfo}</dd>
  </dl>

  {cashbackVerfuegbar && cashbackBetrag && (
    <div class="verdict-cashback">
      <CashbackPill betrag={cashbackBetrag} />
      <a href="/cashback" style="font-size:var(--text-xs);color:var(--text-tertiary);margin-left:6px">Wie funktioniert das?</a>
    </div>
  )}

  <AffiliateLink href={affiliateUrl} produktName={produktName} variant="primary" class="verdict-cta">
    Zu {produktAnbieter}
  </AffiliateLink>

  <p class="verdict-disclosure">
    Wir erhalten eine Provision bei Abschluss — ohne Mehrkosten für dich.
  </p>

  {saeule === 'finance' && (
    <p class="verdict-disclosure"><a href="#risikohinweis">Risikohinweis Geldanlage →</a></p>
  )}
</aside>

<style>
  .verdict-box {
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    box-shadow: var(--shadow-hover);
  }
  .verdict-box[data-saeule="finance"]    { border-top: 3px solid var(--accent-primary); }
  .verdict-box[data-saeule="wellbeing"]  { border-top: 3px solid var(--accent-wellbeing); }
  .verdict-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-secondary);
    background: var(--accent-secondary-bg);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }
  .verdict-anbieter {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
  }
  .verdict-produkt {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .verdict-rating {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .verdict-stars { color: var(--accent-secondary); font-size: 18px; letter-spacing: 1px; }
  .verdict-stars .empty { color: var(--border-default); }
  .verdict-score { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--text-secondary); }
  .verdict-score strong { font-size: var(--text-xl); color: var(--text-primary); margin-right: 2px; }
  .verdict-meta { margin: 0 0 var(--space-6); display: grid; grid-template-columns: auto 1fr; gap: var(--space-2) var(--space-4); }
  .verdict-meta dt { font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-tertiary); align-self: center; }
  .verdict-meta dd { margin: 0; font-size: var(--text-sm); color: var(--text-primary); }
  .verdict-cashback { display: flex; align-items: center; margin-bottom: var(--space-4); }
  .verdict-cta { width: 100%; justify-content: center; margin-bottom: var(--space-3); }
  .verdict-disclosure { font-size: var(--text-xs); color: var(--text-tertiary); margin: 0 0 var(--space-2); }
</style>
