---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisclosureBar from '../components/DisclosureBar.astro';
import { organizationSchema } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  showDisclosure?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  jsonLd,
  showDisclosure = true,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://finanzkompass.de';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage ?? `${siteUrl}/og-default.png`;

const fullTitle = title === 'Finanzkompass' ? title : `${title} · Finanzkompass`;

const ldArr: object[] = [organizationSchema(siteUrl)];
if (jsonLd) {
  if (Array.isArray(jsonLd)) ldArr.push(...jsonLd);
  else ldArr.push(jsonLd);
}
---
<!doctype html>
<html lang="de" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Finanzkompass" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Finanzkompass — Aktuelle Tests" href="/rss.xml" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(ldArr)} />

  <!-- Theme bootstrap (runs before paint to avoid FOUC) -->
  <script is:inline>
    (function() {
      try {
        const t = localStorage.getItem('fk-theme');
        if (t === 'dark' || t === 'light') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    })();
  </script>

  <!-- Cloudflare Web Analytics (cookie-free, DSGVO-compliant). Token must be set after deploy. -->
  <!-- <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "PLACEHOLDER_CF_ANALYTICS_TOKEN"}'></script> -->
</head>
<body>
  <a class="skip" href="#main">Zum Inhalt springen</a>

  <Header />
  {showDisclosure && <DisclosureBar />}

  <main id="main">
    <slot />
  </main>

  <Footer />
</body>
</html>
