---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterFormular from '../components/NewsletterFormular.astro';
import { getCollection } from 'astro:content';
import { formatGermanDate } from '../lib/seo';

export const prerender = true;

// Live-Daten aus den Content-Collections
const allTests = await getCollection('tests', ({ data }) => !data.draft);
const allVergleiche = await getCollection('vergleiche', ({ data }) => !data.draft);
const allRatgeber = await getCollection('ratgeber', ({ data }) => !data.draft);

const tests = allTests
  .sort((a, b) => +new Date(b.data.veroeffentlicht) - +new Date(a.data.veroeffentlicht));
const vergleiche = allVergleiche
  .sort((a, b) => +new Date(b.data.veroeffentlicht) - +new Date(a.data.veroeffentlicht));
const ratgeber = allRatgeber
  .sort((a, b) => +new Date(b.data.veroeffentlicht) - +new Date(a.data.veroeffentlicht));

// Cover-Story = neuester Vergleich (sonst neuester Test)
const cover = vergleiche[0] ?? tests[0] ?? null;
const coverUrl = cover
  ? (vergleiche[0]
      ? `/vergleiche/${cover.id.replace(/\.md$/, '')}`
      : `/${cover.data.saeule === 'wellbeing' ? 'wellbeing' : 'finanzen'}/${cover.id.replace(/\.md$/, '')}`)
  : '/finanzen';

// Echte durchschnittliche Testdauer berechnen
const durations = tests
  .map((t) => t.data.testdauerTage)
  .filter((d): d is number => typeof d === 'number');
const avgDuration = durations.length
  ? Math.round(durations.reduce((a, b) => a + b, 0) / durations.length)
  : 0;

// Latest content für die Cards-Sektion (gemischt: Tests + Vergleiche)
const latest = [
  ...tests.map((t) => ({
    type: 'test' as const,
    id: t.id.replace(/\.md$/, ''),
    titel: t.data.titel,
    beschreibung: t.data.beschreibung,
    saeule: t.data.saeule,
    kategorie: t.data.kategorie,
    veroeffentlicht: t.data.veroeffentlicht,
    cashbackVerfuegbar: t.data.cashbackVerfuegbar,
    cashbackBetrag: t.data.cashbackBetrag,
    produktAnbieter: t.data.produktAnbieter,
  })),
  ...vergleiche.map((v) => ({
    type: 'vergleich' as const,
    id: v.id.replace(/\.md$/, ''),
    titel: v.data.titel,
    beschreibung: v.data.beschreibung,
    saeule: v.data.saeule,
    kategorie: 'Vergleich',
    veroeffentlicht: v.data.veroeffentlicht,
    cashbackVerfuegbar: false,
    cashbackBetrag: undefined,
    produktAnbieter: 'VS',
  })),
]
  .sort((a, b) => +new Date(b.veroeffentlicht) - +new Date(a.veroeffentlicht))
  .slice(0, 3);

const issueDate = new Date().toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="Finanzkompass"
  description="Finanzkompass ist ein zweiköpfiges Redaktionsprojekt. Wir testen Neobroker, ETF-Plattformen und Wellbeing-Apps auf eigene Kosten — und geben einen Teil jeder Provision als Cashback zurück."
>
  <section class="hero">
    <div class="container">
      <div class="hero-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Stand · {issueDate}
      </div>
      <h1>
        Finanztools &amp; Wellbeing,<br />
        <em>geprüft.</em>
      </h1>
      <p class="hero-sub">
        Finanzkompass ist ein zweiköpfiges Redaktionsprojekt. Wir testen Neobroker, ETF-Plattformen und Wellbeing-Apps auf eigene Kosten &mdash; und geben einen Teil jeder Provision als Cashback zurück.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#latest">
          Aktuelle Tests
          <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a class="btn-link" href="/ratgeber">
          Ratgeber
          <svg class="arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a class="btn-link" href="/cashback">
          Cashback erklärt
          <svg class="arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

      <dl class="hero-meta">
        <div><dt>Tests &amp; Vergleiche</dt><dd class="mono">{tests.length + vergleiche.length}</dd></div>
        <div><dt>Ratgeber</dt><dd class="mono">{ratgeber.length}</dd></div>
        <div><dt>Sponsored Content</dt><dd class="mono">0</dd></div>
        <div><dt>Ø Testdauer</dt><dd class="mono">{avgDuration > 0 ? avgDuration : '—'}<span class="unit">Tage</span></dd></div>
      </dl>
    </div>
  </section>

  {cover && (
    <section class="editors-pick">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="section-eyebrow"><span class="idx">01</span> · Cover Story</div>
            <h2 class="section-title">Aktuell im Fokus</h2>
          </div>
          <div class="section-action">
            <span>Stand {formatGermanDate(cover.data.aktualisiert)}</span>
            <span class="mono">→</span>
            <a href="/vergleiche">Alle Vergleiche</a>
          </div>
        </div>

        <article class="cover-story">
          <div class="cover-art" data-label={`[ ${cover.data.titel.slice(0, 80)} ]`}>
            <span class="cover-pill">Editor&rsquo;s Pick</span>
          </div>
          <div class="cover-body">
            <div class="cover-cat">
              {vergleiche[0] ? 'Vergleich' : (cover.data.saeule === 'wellbeing' ? 'Wellbeing' : 'Finanzen')}
              {!vergleiche[0] && cover.data.kategorie && ` · ${cover.data.kategorie}`}
            </div>
            <h3 class="cover-title">{cover.data.titel}</h3>
            <p class="cover-dek">{cover.data.beschreibung}</p>
            <div class="cover-meta">
              <span>Die Finanzkompass-Redaktion</span>
              <span class="sep" aria-hidden="true"></span>
              <span>{formatGermanDate(cover.data.veroeffentlicht)}</span>
            </div>
            <div class="cover-cta">
              <a class="btn btn-primary" href={coverUrl}>
                Zum vollständigen Artikel
                <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  <section id="latest" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-eyebrow"><span class="idx">02</span> · Neueste Inhalte</div>
          <h2 class="section-title">Tests &amp; Vergleiche</h2>
        </div>
        <div class="section-action">
          <a href="/finanzen">Finanzen</a>
          <span class="mono">·</span>
          <a href="/wellbeing">Wellbeing</a>
          <span class="mono">·</span>
          <a href="/vergleiche">Vergleiche</a>
        </div>
      </div>
    </div>

    <div class="container" style="padding-inline:0">
      <div class="cards-3">
        {latest.map((t, i) => {
          const href = t.type === 'vergleich'
            ? `/vergleiche/${t.id}`
            : `/${t.saeule === 'wellbeing' ? 'wellbeing' : 'finanzen'}/${t.id}`;
          const accentColor = t.saeule === 'wellbeing' ? 'color:var(--accent-wellbeing)' : '';
          return (
            <article class="card" style="position:relative">
              <div class="card-cat" style={accentColor}>
                <span class="card-num">{String(i + 1).padStart(3, '0')}</span>
                {t.type === 'vergleich' ? 'Vergleich' : (t.saeule === 'wellbeing' ? 'Wellbeing' : 'Finanzen')}
                {t.type !== 'vergleich' && ` · ${t.kategorie}`}
              </div>
              <h3 class="card-title"><a href={href}>{t.titel}</a></h3>
              <p class="card-excerpt">{t.beschreibung}</p>
              <div class="card-foot">
                <div class="left"><span>Die Redaktion</span><span class="sep" aria-hidden="true"></span><span>{formatGermanDate(t.veroeffentlicht)}</span></div>
                <span class="card-logo" aria-hidden="true">{t.produktAnbieter.slice(0,2).toUpperCase()}</span>
              </div>
              {t.cashbackVerfuegbar && t.cashbackBetrag && (
                <span class="card-cashback" style="position:absolute;top:var(--space-6);right:var(--space-8)">{t.cashbackBetrag}&thinsp;€ Cashback</span>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {ratgeber.length > 0 && (
    <section style="padding-top:var(--space-12)">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="section-eyebrow"><span class="idx">03</span> · Grundlagen</div>
            <h2 class="section-title">Bevor du ein Produkt wählst</h2>
          </div>
          <div class="section-action">
            <a href="/ratgeber">Alle Ratgeber</a>
            <span class="mono">·</span>
            <a href="/glossar">Glossar</a>
            <span class="mono">·</span>
            <a href="/suche">Suche</a>
          </div>
        </div>
      </div>

      <div class="container" style="padding-inline:0">
        <div class="cards-3">
          {ratgeber.slice(0, 3).map((r) => (
            <article class="card">
              <div class="card-cat" style={r.data.saeule === 'wellbeing' ? 'color:var(--accent-wellbeing)' : ''}>
                Ratgeber · {r.data.kategorie}
                {r.data.isPillarPage && <span style="margin-left:6px;color:var(--accent-secondary);font-weight:600">Pillar</span>}
              </div>
              <h3 class="card-title">
                <a href={`/ratgeber/${r.id.replace(/\.md$/, '')}`}>{r.data.titel}</a>
              </h3>
              <p class="card-excerpt">{r.data.beschreibung}</p>
              <div class="card-foot">
                <div class="left"><span>Grundlagen</span><span class="sep" aria-hidden="true"></span><span>{formatGermanDate(r.data.aktualisiert)}</span></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="cashback" class="cashback-band cashback">
    <div class="container cashback-grid">
      <div>
        <div class="cashback-eyebrow">
          <span class="badge">Beta</span>
          Unser Modell
        </div>
        <h2>Wir teilen unsere Provision mit dir.</h2>
        <p>
          Wenn du ein Produkt über unsere Links abschließt, zahlt der Anbieter uns eine Vermittlungsprovision. Einen Teil davon geben wir direkt an dich zurück &mdash; transparent aufgeschlüsselt, per PayPal oder SEPA-Überweisung.
        </p>
        <div class="cover-cta">
          <a class="btn btn-secondary" href="/cashback">
            So funktioniert Cashback
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a class="btn-link" href="/ratgeber/cashback-richtig-versteuern" style="border-color:var(--accent-secondary);color:var(--accent-secondary)">
            Steuerlich richtig behandeln
          </a>
        </div>
      </div>

      <div class="cb-schematic" aria-label="Cashback-Schema">
        <div class="cb-row">
          <span class="cb-step">01</span>
          <div class="cb-label">Du schließt ein geprüftes Produkt ab<small>über einen Finanzkompass-Link</small></div>
          <span class="cb-amount">Depot</span>
        </div>
        <div class="cb-row">
          <span class="cb-step">02</span>
          <div class="cb-label">Anbieter zahlt uns eine Provision<small>standardisierte Vermittlungsprovision</small></div>
          <span class="cb-amount">€20,00</span>
        </div>
        <div class="cb-row">
          <span class="cb-step">03</span>
          <div class="cb-label">Wir decken Testkosten &amp; Redaktion<small>Hosting, Recherche, Lektorat</small></div>
          <span class="cb-amount">€8,00</span>
        </div>
        <div class="cb-row">
          <span class="cb-step">04</span>
          <div class="cb-label">Du bekommst Cashback<small>per PayPal oder SEPA-Überweisung</small></div>
          <span class="cb-amount is-cashback">+€12,00</span>
        </div>
        <div class="cb-foot">
          <span>Beispiel · Trade Republic Depot</span>
          <span>Stand {issueDate}</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <div class="section-eyebrow"><span class="idx">04</span> · Ressorts</div>
          <h2 class="section-title">Drei Ressorts. Ein Standard.</h2>
        </div>
        <div class="section-action">
          <a href="/methodik">Methodik <span class="mono">→</span></a>
        </div>
      </div>

      <div class="cat-grid">
        <a class="cat-card cat-finanzen" href="/finanzen">
          <div class="cat-accent" aria-hidden="true"></div>
          <div class="cat-head"><span class="cat-num">A</span><span class="cat-count">Neobroker · ETF · Banking</span></div>
          <h3 class="cat-title">Finanzen</h3>
          <p class="cat-desc">Neobroker, ETF-Sparpläne, Banking und Versicherungen &mdash; getestet gegen echte Konten, nicht gegen Demo-Daten.</p>
          <div class="cat-foot">
            <span>Finanzen ansehen</span>
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </div>
        </a>

        <a class="cat-card cat-wellbeing" href="/wellbeing">
          <div class="cat-accent" aria-hidden="true"></div>
          <div class="cat-head"><span class="cat-num">B</span><span class="cat-count">Therapie · Mindfulness</span></div>
          <h3 class="cat-title">Wellbeing</h3>
          <p class="cat-desc">Online-Therapie, Mindfulness-Apps und mentale Gesundheit &mdash; wir testen mit echten Sitzungen, nicht mit Screenshots.</p>
          <div class="cat-foot">
            <span>Wellbeing ansehen</span>
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </div>
        </a>

        <a class="cat-card cat-vergleiche" href="/vergleiche">
          <div class="cat-accent" aria-hidden="true"></div>
          <div class="cat-head"><span class="cat-num">C</span><span class="cat-count">Direkte Duelle</span></div>
          <h3 class="cat-title">Vergleiche</h3>
          <p class="cat-desc">Direkte Produkt-Duelle. Wir lesen das Kleingedruckte, das die Affiliate-Seiten überspringen.</p>
          <div class="cat-foot">
            <span>Vergleiche ansehen</span>
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <NewsletterFormular variant="banner" />
</BaseLayout>
